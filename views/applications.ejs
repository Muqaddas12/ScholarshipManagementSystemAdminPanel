<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Applications</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('form[action*="/accept"], form[action*="/reject"], form[action*="/delete"], form[action*="/revert"]').forEach(form => {
        form.addEventListener('submit', (e) => {
          const action = form.action.includes('accept') ? 'accept' :
                         form.action.includes('reject') ? 'reject' :
                         form.action.includes('revert') ? 'revert' : 'delete';
          const confirmed = confirm(`Are you sure you want to ${action} this application?`);
          if (!confirmed) e.preventDefault();
        });
      });

      const toggleBtn = document.getElementById("menu-toggle");
      const menu = document.getElementById("mobile-menu");
      toggleBtn?.addEventListener("click", () => {
        menu.classList.toggle("hidden");
      });

      const params = new URLSearchParams(window.location.search);
      const msg = params.get('msg');
      const err = params.get('error');
      if (msg) alert(msg);
      if (err) alert(`Error: ${err}`);
    });
  </script>
</head>
<body class="bg-gray-100 min-h-screen flex flex-col">

  <!-- Header -->
  <header class="bg-gray-800 text-white shadow-md">
    <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
      <div class="flex items-center space-x-3">
        <img src="https://flowbite.com/docs/images/logo.svg" class="h-8" alt="Logo" />
        <span class="text-2xl font-bold">Sugsms</span>
      </div>
      <div class="hidden md:flex space-x-6">
        <a href="/admin/homepage" class="hover:text-gray-300">Dashboard</a>
        <a href="/admin/applications" class="hover:text-gray-300">Applications</a>
        <a href="/admin/upload" class="hover:text-gray-300">Upload</a>
        <a href="/admin/logout" class="hover:text-gray-300">Logout</a>
      </div>
      <button id="menu-toggle" class="md:hidden focus:outline-none">
        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
    <div id="mobile-menu" class="md:hidden hidden bg-gray-700 px-4 pb-4 space-y-2">
      <a href="/admin/homepage" class="block text-white hover:text-gray-300">Dashboard</a>
      <a href="/admin/applications" class="block text-white hover:text-gray-300">Applications</a>
      <a href="/admin/upload" class="block text-white hover:text-gray-300">Upload</a>
      <a href="/admin/logout" class="block text-white hover:text-gray-300">Logout</a>
    </div>
  </header>

  <!-- Main Content -->
  <main class="flex-grow container mx-auto px-4 py-6">

    <!-- Filter Buttons -->
    <div class="flex flex-wrap justify-between items-center mb-6 gap-4">
      <h1 class="text-2xl font-bold">Applications</h1>
      <div class="flex flex-wrap gap-2">
        <a href="/admin/applications?status=pending">
          <button class="px-4 py-2 rounded <%= currentStatus === 'pending' ? 'bg-yellow-600' : 'bg-yellow-500 hover:bg-yellow-600' %> text-white">Pending</button>
        </a>
        <a href="/admin/applications?status=accepted">
          <button class="px-4 py-2 rounded <%= currentStatus === 'accepted' ? 'bg-green-700' : 'bg-green-600 hover:bg-green-700' %> text-white">Accepted</button>
        </a>
        <a href="/admin/applications?status=rejected">
          <button class="px-4 py-2 rounded <%= currentStatus === 'rejected' ? 'bg-red-700' : 'bg-red-600 hover:bg-red-700' %> text-white">Rejected</button>
        </a>
        <a href="/admin/applications">
          <button class="px-4 py-2 rounded <%= currentStatus === 'all' ? 'bg-gray-700' : 'bg-gray-500 hover:bg-gray-700' %> text-white">All</button>
        </a>
        <a href="/admin/applications?status=deleted">
          <button class="px-4 py-2 rounded <%= currentStatus === 'deleted' ? 'bg-black' : 'bg-gray-800 hover:bg-black' %> text-white">Deleted</button>
        </a>
      </div>
    </div>

    <!-- Applications List -->
    <div class="space-y-4">
      <% if (applications.length === 0) { %>
        <p class="text-gray-600">No applications found.</p>
      <% } else { %>
        <% applications.forEach(app => { %>
          <div class="flex flex-col lg:flex-row justify-between gap-4 bg-white p-4 rounded shadow hover:bg-gray-50">
            <div class="flex-grow space-y-1">
              <p><strong>Name:</strong> <%= app.studentName %></p>
              <p><strong>Roll Number:</strong> <%= app.rollNumber %></p>
              <p><strong>Course:</strong> <%= app.course %></p>
              <p><strong>Graduation Year:</strong> <%= app.graduationYear %></p>
              <p><strong>Department:</strong> <%= app.department %></p>
              <p><strong>File:</strong> <a href="/<%= app.file.path %>" target="_blank" class="text-blue-600 underline">View PDF</a></p>
            </div>
            <div class="flex flex-col lg:flex-row gap-2 items-start lg:items-center">
              <span class="text-gray-700">Status: <%= app.status.charAt(0).toUpperCase() + app.status.slice(1) %></span>

              <% if (currentStatus === 'pending') { %>
                <form method="POST" action="/admin/applications/<%= app._id %>/accept">
                  <button class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">Accept</button>
                </form>
                <form method="POST" action="/admin/applications/<%= app._id %>/reject">
                  <button class="px-4 py-2 bg-red-600 text-white rounded hover:bg-red-700">Reject</button>
                </form>

              <% } else if (currentStatus === 'accepted') { %>
                <form method="POST" action="/admin/applications/<%= app._id %>/reject">
                  <button class="px-4 py-2 bg-red-600 text-white rounded hover:bg-red-700">Reject</button>
                </form>
                <form method="POST" action="/admin/applications/<%= app._id %>/delete">
                  <button class="px-4 py-2 bg-gray-700 text-white rounded hover:bg-black">Delete</button>
                </form>
                <form method="POST" action="/admin/applications/<%= app._id %>/revert">
                  <button class="px-4 py-2 bg-yellow-600 text-white rounded hover:bg-yellow-700">Revert to Pending</button>
                </form>

              <% } else if (currentStatus === 'rejected') { %>
                <form method="POST" action="/admin/applications/<%= app._id %>/accept">
                  <button class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">Accept</button>
                </form>
                <form method="POST" action="/admin/applications/<%= app._id %>/revert">
                  <button class="px-4 py-2 bg-yellow-600 text-white rounded hover:bg-yellow-700">Revert to Pending</button>
                </form>

              <% } else if (currentStatus === 'deleted') { %>
                <form method="POST" action="/admin/applications/<%= app._id %>/revert">
                  <button class="px-4 py-2 bg-yellow-600 text-white rounded hover:bg-yellow-700">Revert to Pending</button>
                </form>

              <% } %>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>

  </main>
</body>
</html>
